<%
// 按分类归集文章
const techPosts = [];
const newsPosts = [];
site.posts.each(function(post) {
    const cats = post.categories.toArray().map(c => c.name);
    if (cats.includes('技术中心')) techPosts.push(post);
    else if (cats.includes('新闻资讯')) newsPosts.push(post);
});
techPosts.sort((a, b) => b.date - a.date);
newsPosts.sort((a, b) => b.date - a.date);

function renderPost(post) {
    const cover = post.cover || 'https://images.unsplash.com/photo-1520523839897-bd0b52f945a0?q=80&w=320';
    const tag = post.categories.toArray()[0] ? post.categories.toArray()[0].name : '';
    const tagBg = tag === '技术中心'
        ? 'bg-[#00f0ff]/10 text-[#00f0ff]/90 border-[#00f0ff]/20'
        : 'bg-white/5 text-gray-300 border-white/10';
    const excerpt = post.excerpt || post.content.replace(/<[^>]*>/g, '').substring(0, 120) + '...';
    return `
    <a href="${url_for(post.path)}" class="block group bg-[#0f0f0f] hover:bg-[#1a1a1a] border border-white/5 hover:border-white/10 rounded-xl md:rounded-2xl p-4 md:p-6 transition-all duration-300 shadow-sm hover:shadow-[0_0_30px_rgba(0,240,255,0.05)]">
        <article class="flex gap-4 md:gap-6 items-center md:items-start">
            <div class="w-28 h-20 sm:w-40 sm:h-28 md:w-48 md:h-32 shrink-0 overflow-hidden rounded-lg bg-zinc-900 relative">
                <img src="${cover}" class="w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-110 transition-all duration-500" alt="${post.title}">
            </div>
            <div class="flex-1 min-w-0 py-1 md:py-2">
                <h3 class="text-base md:text-xl font-bold mb-1 md:mb-2 text-gray-100 group-hover:text-[#00f0ff] transition-colors truncate">${post.title}</h3>
                <p class="text-gray-400 text-xs md:text-sm line-clamp-1 md:line-clamp-2 leading-relaxed">${excerpt}</p>
                <div class="mt-2 md:mt-4 flex items-center gap-3 md:gap-4 text-[10px] md:text-xs text-gray-500 font-medium">
                    <span class="flex items-center gap-1"><i class="fa-regular fa-calendar"></i> ${post.date.format('YYYY-MM-DD')}</span>
                    ${tag ? `<span class="px-2 py-0.5 rounded border ${tagBg}">${tag}</span>` : ''}
                </div>
            </div>
        </article>
    </a>`;
}
%>

<!-- 顶部横幅 -->
<header class="relative pt-32 md:pt-40 pb-16 md:pb-20 overflow-hidden">
    <div class="absolute inset-0 z-0">
        <img src="https://images.unsplash.com/photo-1470225620780-dba8ba36b745?q=80&w=2000&auto=format&fit=crop" alt="Banner" class="w-full h-full object-cover">
        <div class="absolute inset-0 banner-overlay"></div>
    </div>
    <div class="relative z-10 max-w-5xl mx-auto px-6">
        <div class="inline-block px-3 py-1 bg-[#00f0ff]/10 border border-[#00f0ff]/30 text-[#00f0ff] text-[10px] md:text-xs font-bold tracking-widest uppercase mb-4 rounded backdrop-blur-sm">
            Tech & News
        </div>
        <h1 class="text-3xl md:text-5xl font-bold mb-3 md:mb-4 text-white">技术·资讯</h1>
        <p class="text-gray-300 text-base md:text-xl max-w-2xl">掌握最新的电声技术应用与雷域企业动态</p>
    </div>
</header>

<!-- 主内容 -->
<main class="max-w-5xl mx-auto px-4 md:px-6 py-8 md:py-16 min-h-[60vh]">

    <!-- 标签导航 -->
    <div class="flex items-center gap-6 md:gap-10 mb-8 border-b border-white/10 overflow-x-auto no-scrollbar">
        <button onclick="switchTab('tech')" id="btn-tech"
            class="tab-btn whitespace-nowrap text-lg md:text-2xl font-bold pb-3 border-b-2 border-[#00f0ff] text-[#00f0ff] transition-all flex items-center gap-2">
            <i class="fa-solid fa-microchip"></i> 技术中心
        </button>
        <button onclick="switchTab('news')" id="btn-news"
            class="tab-btn whitespace-nowrap text-lg md:text-2xl font-bold pb-3 border-b-2 border-transparent text-gray-500 hover:text-gray-300 transition-all flex items-center gap-2">
            <i class="fa-regular fa-newspaper"></i> 新闻资讯
        </button>
    </div>

    <div class="relative">
        <!-- 技术中心 -->
        <section id="content-tech" class="tab-content block animate-fade-in-up">
            <% if (techPosts.length > 0) { %>
                <div class="space-y-4 md:space-y-6">
                    <%- techPosts.map(renderPost).join('') %>
                </div>
                <div class="mt-10 text-center">
                    <button class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full border border-white/20 text-sm text-white hover:border-[#00f0ff] hover:text-[#00f0ff] transition-all">
                        加载更多 <i class="fa-solid fa-angle-down"></i>
                    </button>
                </div>
            <% } else { %>
                <div class="text-center py-20 text-gray-500">
                    <i class="fa-solid fa-microchip text-4xl mb-4 block"></i>
                    暂无技术文章，敬请期待
                </div>
            <% } %>
        </section>

        <!-- 新闻资讯 -->
        <section id="content-news" class="tab-content hidden">
            <% if (newsPosts.length > 0) { %>
                <div class="space-y-4 md:space-y-6">
                    <%- newsPosts.map(renderPost).join('') %>
                </div>
                <div class="mt-10 text-center">
                    <button class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full border border-white/20 text-sm text-white hover:border-[#00f0ff] hover:text-[#00f0ff] transition-all">
                        加载更多 <i class="fa-solid fa-angle-down"></i>
                    </button>
                </div>
            <% } else { %>
                <div class="text-center py-20 text-gray-500">
                    <i class="fa-regular fa-newspaper text-4xl mb-4 block"></i>
                    暂无新闻资讯，敬请期待
                </div>
            <% } %>
        </section>
    </div>
</main>

<script>
function switchTab(tabName) {
    ['tech', 'news'].forEach(tab => {
        const btn = document.getElementById('btn-' + tab);
        if (tab === tabName) {
            btn.classList.remove('text-gray-500', 'border-transparent');
            btn.classList.add('text-[#00f0ff]', 'border-[#00f0ff]');
        } else {
            btn.classList.remove('text-[#00f0ff]', 'border-[#00f0ff]');
            btn.classList.add('text-gray-500', 'border-transparent');
        }
    });
    document.querySelectorAll('.tab-content').forEach(c => {
        c.classList.add('hidden');
        c.classList.remove('animate-fade-in-up');
    });
    const active = document.getElementById('content-' + tabName);
    active.classList.remove('hidden');
    void active.offsetWidth;
    active.classList.add('animate-fade-in-up');
}
</script>
