// ========== 子分类固定定义 ==========
const FIXED_SUBS = {
    '音箱': [],
    '功放': [],
    '其他': []
};

let activeCategory = '全部';
let activeSub = '全部';
let searchQuery = '';

// ========== 辅助函数 ==========
function getSubCategories(cat) {
    if (cat === '全部') return [];
    const fromData = [...new Set(PRODUCTS.filter(p => p.category === cat).map(p => p.subCategory))];
    const merged = [...new Set([...(FIXED_SUBS[cat] || []), ...fromData])];
    return ['全部', ...merged];
}

function getFilteredProducts() {
    return PRODUCTS.filter(p => {
        const matchCat = activeCategory === '全部' || p.category === activeCategory;
        const matchSub = activeSub === '全部' || p.subCategory === activeSub;
        const q = searchQuery.toLowerCase();
        const matchSearch = p.name.toLowerCase().includes(q) || p.desc.toLowerCase().includes(q);
        return matchCat && matchSub && matchSearch;
    });
}

// ========== 渲染函数 ==========
function renderSubCatBar() {
    const subs = getSubCategories(activeCategory);
    const bar = document.getElementById('sub-cat-bar');
    const btnsContainer = document.getElementById('sub-cat-btns');

    if (subs.length === 0 || activeCategory === '全部') {
        bar.classList.add('hidden');
        return;
    }
    bar.classList.remove('hidden');
    btnsContainer.innerHTML = subs.map(sub => `
        <button
            onclick="setSub('${sub}')"
            class="sub-btn flex-shrink-0 px-4 py-1.5 rounded-full text-xs font-medium transition-all ${
                activeSub === sub
                    ? 'bg-gray-200 text-gray-900 font-bold'
                    : 'text-gray-500 hover:bg-gray-100'
            }"
        >${sub}</button>
    `).join('');
}

function renderProducts() {
    const filtered = getFilteredProducts();
    const grid = document.getElementById('product-grid');
    const empty = document.getElementById('empty-state');
    const countEl = document.getElementById('product-count');
    const titleEl = document.getElementById('section-title');

    // 更新标题
    if (activeCategory === '全部') {
        titleEl.innerHTML = '所有设备';
    } else {
        titleEl.innerHTML = activeCategory + '系列' + (activeSub !== '全部' ? `<span class="text-gray-400 font-light ml-2">/ ${activeSub}</span>` : '');
    }

    countEl.textContent = filtered.length + ' 款产品';

    if (filtered.length === 0) {
        grid.innerHTML = '';
        empty.classList.remove('hidden');
        empty.classList.add('flex');
    } else {
        empty.classList.add('hidden');
        empty.classList.remove('flex');
        grid.innerHTML = filtered.map((p, i) => `
            <article
                onclick="openDetail(${p.id})"
                class="product-card-enter group flex flex-col bg-white border border-gray-100 rounded-3xl overflow-hidden hover:border-[#00f0ff]/50 transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_20px_50px_rgba(0,0,0,0.06)] cursor-pointer"
                style="animation-delay: ${i * 50}ms"
            >
                <figure class="relative aspect-[4/3] bg-gray-50 flex items-center justify-center p-8 overflow-hidden">
                    <span class="text-7xl group-hover:scale-110 transition-transform duration-500 drop-shadow-md">${p.image}</span>
                    <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity bg-white/40 backdrop-blur-[2px] flex items-center justify-center">
                        <span class="px-6 py-2.5 bg-gray-900 text-white text-xs font-bold rounded-full shadow-2xl flex items-center gap-2 transform translate-y-4 group-hover:translate-y-0 transition-all">
                            查看详情 <i class="fa-solid fa-chevron-right text-[10px]"></i>
                        </span>
                    </div>
                </figure>
                <div class="p-6 flex flex-col flex-1">
                    <h3 class="text-lg font-bold text-gray-900 mb-2 group-hover:text-[#00f0ff] transition-colors">${p.name}</h3>
                    <div class="grid grid-cols-2 gap-3 mt-auto pt-6 border-t border-gray-100">
                        <div>
                            <div class="text-[9px] text-gray-400 uppercase tracking-widest mb-1 flex items-center gap-1">
                                <i class="fa-solid fa-microchip text-[8px]"></i> 功率
                            </div>
                            <div class="text-sm font-bold text-gray-700">${p.power}</div>
                        </div>
                        <div>
                            <div class="text-[9px] text-gray-400 uppercase tracking-widest mb-1 flex items-center gap-1">
                                <i class="fa-solid fa-gear text-[8px]"></i> 规格
                            </div>
                            <div class="text-sm font-bold text-gray-700">${p.size}</div>
                        </div>
                    </div>
                </div>
            </article>
        `).join('');
    }
}

// ========== 详情页 ==========
function openDetail(id) {
    const p = PRODUCTS.find(x => x.id === id);
    if (!p) return;

    document.getElementById('detail-image').textContent = p.image;
    document.getElementById('detail-category').textContent = p.category + ' | ' + p.subCategory;
    document.getElementById('detail-name').textContent = p.name;
    document.getElementById('detail-desc').textContent = p.desc;

    const s = p.specs || {};
    const rows = [
        { en: 'Description', cn: '描述', val: s.description },
        { en: 'Configuration', cn: '配置', val: s.configuration },
        { en: 'Drivers', cn: '单元组成 LF', val: s.driversLF },
        { en: 'Drivers', cn: '单元组成 HF', val: s.driversHF },
        { en: 'Frequency Range', cn: '轴向频率响应', val: s.freqRange },
        { en: 'Sensitivity', cn: '灵敏度', val: s.sensitivity },
        { en: 'MAX SPL', cn: '最大声压级', val: s.maxSpl },
        { en: 'Nominal Impedance', cn: '标称阻抗', val: s.nominalImp },
        { en: 'Continuous/Peak', cn: '功率: 额定/峰值', val: s.contPower },
        { en: 'Recommended amplifier', cn: '推荐功放 (@8Ω)', val: s.recAmp },
        { en: 'Enclosure material', cn: '箱体板材', val: s.enclosure },
        { en: 'Finish', cn: '表面油漆', val: s.finish },
        { en: 'Dimension (W×D×H)', cn: '产品尺寸', val: s.dimension },
        { en: 'Net Weight(Kg)', cn: '产品净重', val: s.weight },
    ];

    document.getElementById('detail-specs-tbody').innerHTML = rows.map((row, i) => `
        <tr class="border-b border-gray-100 last:border-0 ${i % 2 === 0 ? 'bg-white' : 'bg-gray-50/30'}">
            <td class="py-4 px-6 font-medium text-gray-500 w-1/3 border-r border-gray-100">
                <span class="text-gray-400 mr-2">${row.en}</span>
                <span class="text-gray-700">${row.cn}:</span>
            </td>
            <td class="py-4 px-6 text-gray-600">${row.val || 'N/A'}</td>
        </tr>
    `).join('');

    document.getElementById('products-list-view').classList.add('hidden');
    document.getElementById('filter-bar').classList.add('hidden');
    document.getElementById('product-detail-view').classList.remove('hidden');
    window.scrollTo({ top: 0, behavior: 'smooth' });
}

function closeDetail() {
    document.getElementById('product-detail-view').classList.add('hidden');
    document.getElementById('products-list-view').classList.remove('hidden');
    document.getElementById('filter-bar').classList.remove('hidden');
    window.scrollTo({ top: 0, behavior: 'smooth' });
}

// ========== 事件处理 ==========
function setCategory(cat) {
    activeCategory = cat;
    activeSub = '全部';

    // 更新主分类按钮样式
    document.querySelectorAll('.cat-btn').forEach(btn => {
        const isActive = btn.dataset.cat === cat;
        btn.className = `cat-btn flex-shrink-0 flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-bold transition-all border ${
            isActive
                ? 'bg-[#00f0ff] border-transparent text-white shadow-md'
                : 'bg-white border-gray-200 text-gray-600 hover:border-gray-400'
        }`;
    });

    renderSubCatBar();
    renderProducts();
}

function setSub(sub) {
    activeSub = sub;

    // 更新子分类按钮样式
    document.querySelectorAll('.sub-btn').forEach(btn => {
        const isActive = btn.textContent.trim() === sub;
        btn.className = `sub-btn flex-shrink-0 px-4 py-1.5 rounded-full text-xs font-medium transition-all ${
            isActive
                ? 'bg-gray-200 text-gray-900 font-bold'
                : 'text-gray-500 hover:bg-gray-100'
        }`;
    });

    renderProducts();
}

function onSearch(val) {
    searchQuery = val;
    renderProducts();
}

// ========== 初始化 ==========
document.addEventListener('DOMContentLoaded', function() {
    renderProducts();
});
</script>
