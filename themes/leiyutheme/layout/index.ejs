<!-- CONTACT -->
<section id="contact" class="py-24 bg-[#0a0a0a]">
    <div class="max-w-7xl mx-auto px-6">
        <div class="grid lg:grid-cols-12 gap-12">
            <div class="lg:col-span-7">
                <h2 class="text-4xl font-bold text-white mb-2">立即获取报价</h2>
                <p class="text-gray-400 mb-10">告诉我们您的项目需求，我们的销售工程师将在24小时内回复</p>
                <form id="inquiry-form" class="space-y-6" onsubmit="handleSubmit(event)">
                    <div class="grid md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-medium mb-3 text-gray-200">您的姓名</label>
                            <input type="text" id="name" required placeholder="请输入您的姓名"
                                   class="form-input w-full bg-[#2a2a2a] border border-white/20 rounded-2xl px-6 py-4 outline-none text-white focus:bg-[#333] transition-all placeholder:text-gray-500">
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-3 text-gray-200">联系方式 (电话/邮箱/微信)</label>
                            <input type="text" id="contact-info" required placeholder="请输入您的联系方式"
                                   class="form-input w-full bg-[#2a2a2a] border border-white/20 rounded-2xl px-6 py-4 outline-none text-white focus:bg-[#333] transition-all placeholder:text-gray-500">
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-3 text-gray-200">项目描述 & 产品需求</label>
                        <textarea id="message" rows="6" placeholder="请描述您的场地规模、音箱类型及功率需求..."
                                  class="form-input w-full bg-[#2a2a2a] border border-white/20 rounded-2xl px-6 py-4 outline-none text-white resize-none focus:bg-[#333] transition-all placeholder:text-gray-500"></textarea>
                    </div>
                    <button type="submit" class="bg-[#00f0ff] hover:bg-[#00e0ee] text-[#0a0a0a] font-bold py-4 px-10 rounded-2xl text-lg flex items-center justify-center gap-3 transition-all">
                        <span>提交需求 · 获取专业方案和报价</span>
                        <i class="fa-solid fa-paper-plane text-sm"></i>
                    </button>
                </form>
            </div>
            <div class="lg:col-span-5">
                <div class="bg-[#14181c] rounded-[2.5rem] p-10 border border-white/5 h-full">
                    <h3 class="text-2xl font-bold mb-8 text-white">联系我们</h3>
                    <div class="space-y-8 mb-12">
                        <div class="flex items-center gap-5">
                            <div class="w-12 h-12 rounded-2xl bg-[#00f0ff]/10 flex items-center justify-center">
                                <i class="fa-solid fa-envelope text-xl text-[#00f0ff]"></i>
                            </div>
                            <div>
                                <p class="text-xs text-gray-400 mb-1">公司邮箱</p>
                                <p class="font-medium text-white">sales@leiyuelectro.com</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-5">
                            <div class="w-12 h-12 rounded-2xl bg-[#00f0ff]/10 flex items-center justify-center">
                                <i class="fa-brands fa-whatsapp text-xl text-[#00f0ff]"></i>
                            </div>
                            <div>
                                <p class="text-xs text-gray-400 mb-1">WhatsApp 国际客服</p>
                                <p class="font-medium text-white">+86 138 1234 5678</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-5">
                            <div class="w-12 h-12 rounded-2xl bg-[#00f0ff]/10 flex items-center justify-center">
                                <i class="fa-brands fa-facebook text-xl text-[#00f0ff]"></i>
                            </div>
                            <div>
                                <p class="text-xs text-gray-400 mb-1">Facebook 官方主页</p>
                                <p class="font-medium text-white">@LeiyuAudio</p>
                            </div>
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-4 text-center">
                        <div class="space-y-3">
                            <div class="bg-white p-2 rounded-xl aspect-square">
                                <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=whatsapp" alt="WhatsApp QR" class="w-full">
                            </div>
                            <p class="text-[10px] text-gray-500 font-medium">WhatsApp</p>
                        </div>
                        <div class="space-y-3">
                            <div class="bg-white p-2 rounded-xl aspect-square">
                                <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=facebook" alt="Facebook QR" class="w-full">
                            </div>
                            <p class="text-[10px] text-gray-500 font-medium">Facebook</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
