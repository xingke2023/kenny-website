<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="<%= config.description %>">
    <title><%= page.title ? page.title + ' | ' + config.title : config.title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    animation: { 'fade-in-up': 'fadeInUp 0.4s ease-out forwards' },
                    keyframes: { fadeInUp: { '0%': { opacity: '0', transform: 'translateY(15px)' }, '100%': { opacity: '1', transform: 'translateY(0)' } } }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Noto+Sans+SC:wght@400;500;600&display=swap');

        :root { --cyan: #00f0ff; }

        body { font-family: 'Noto Sans SC', 'Inter', system-ui, sans-serif; }

        .hero-canvas { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1; pointer-events: none; }

        .navbar { transition: all 0.3s ease; }
        .nav-scrolled { background-color: rgba(10,10,10,0.95) !important; backdrop-filter: blur(12px); }

        .wave-text { text-shadow: 0 0 20px var(--cyan); }

        .new-product-card { background: #0d1117; border-radius: 16px; overflow: hidden; transition: all 0.3s ease; display: flex; flex-direction: column; border: 1px solid rgba(255,255,255,0.05); }
        .new-product-card:hover { transform: translateY(-5px); box-shadow: 0 10px 30px rgba(0,0,0,0.2); border-color: rgba(0,240,255,0.3); }

        .brand-badge { position: absolute; top: 12px; right: 12px; padding: 2px 10px; border-radius: 20px; font-size: 10px; font-weight: bold; color: #000; }
        .badge-egt { background-color: #00f0ff; }
        .badge-meness { background-color: #00d4ff; }

        .form-input { transition: all 0.3s ease; }
        .form-input:focus { border-color: #00f0ff; box-shadow: 0 0 0 1px rgba(0,240,255,0.5); }

        .map-section { background: url('https://upload.wikimedia.org/wikipedia/commons/8/83/Equirectangular_projection_SW.jpg') center/cover no-repeat fixed; padding: 100px 0; position: relative; }
        .map-section::before { content: ''; position: absolute; inset: 0; background: rgba(0,0,0,0.4); pointer-events: none; }

        .map-glass-container { background: rgba(10,25,35,0.85); backdrop-filter: blur(15px); border: 1px solid rgba(0,240,255,0.2); border-radius: 40px; padding: 60px; position: relative; z-index: 2; box-shadow: 0 25px 100px rgba(0,0,0,0.8); }

        .case-card { background: rgba(0,0,0,0.5); border-radius: 20px; padding: 24px; border-left: 4px solid var(--cyan); margin-bottom: 20px; transition: all 0.3s ease; }
        .case-card:hover { background: rgba(0,240,255,0.1); transform: translateX(8px); }

        .review-card { background: rgba(0,0,0,0.5); border-radius: 20px; padding: 24px; margin-bottom: 20px; border: 1px solid rgba(255,255,255,0.05); transition: all 0.3s ease; }
        .review-card:hover { border-color: rgba(0,240,255,0.4); }

        .star-rating { color: #ffc107; margin-bottom: 12px; font-size: 14px; }

        /* 技术资讯页 */
        .banner-overlay { background: linear-gradient(to right, rgba(10,10,10,0.9) 20%, rgba(10,10,10,0.4) 100%); }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

        /* 文章页样式 */
        .post-content { max-width: 800px; margin: 0 auto; line-height: 1.8; }
        .post-content h1, .post-content h2, .post-content h3 { color: #00f0ff; margin: 1.5em 0 0.5em; }
        .post-content p { color: #d1d5db; margin-bottom: 1em; }
        .post-content a { color: #00f0ff; text-decoration: underline; }
        .post-content code { background: #1a1a2e; padding: 2px 6px; border-radius: 4px; font-size: 0.9em; }
        .post-content pre { background: #1a1a2e; padding: 16px; border-radius: 12px; overflow-x: auto; margin: 1em 0; }
    </style>
</head>
