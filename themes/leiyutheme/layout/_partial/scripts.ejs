<script>
    // Tailwind 配置
    if (typeof tailwind !== 'undefined') {
        tailwind.config = { theme: { extend: {} } };
    }

    // 动态日期
    function updateDynamicDates() {
        const currentYear = new Date().getFullYear();
        const startYear = 2004;
        const yearsExp = currentYear - startYear;

        const heroBadge = document.getElementById('hero-badge');
        if (heroBadge) heroBadge.innerHTML = `<i class="fa-solid fa-medal"></i> ${startYear} - ${currentYear} · ${yearsExp}年专业电声制造`;

        const aboutTitle = document.getElementById('about-years-title');
        if (aboutTitle) aboutTitle.innerHTML = `${yearsExp}年专注声音科技，<br>只为震撼每一刻`;

        const aboutStat = document.getElementById('about-years-stat');
        if (aboutStat) aboutStat.innerText = yearsExp;
    }

    // 波形动画（仅首页）
    function initWaveCanvas() {
        const canvas = document.getElementById('wave-canvas');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        function resize() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
        resize();
        window.addEventListener('resize', resize);
        let time = 0;
        function drawWave() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            ctx.strokeStyle = '#00f0ff';
            ctx.lineWidth = 3;
            for (let i = 0; i < 6; i++) {
                ctx.beginPath();
                const amplitude = 40 + i * 15;
                const frequency = 0.008 + i * 0.003;
                for (let x = 0; x < canvas.width; x += 4) {
                    const y = canvas.height * 0.6 + Math.sin(x * frequency + time + i) * amplitude + Math.cos(x * frequency * 1.3 + time * 1.2) * (amplitude / 2);
                    ctx.lineTo(x, y);
                }
                ctx.stroke();
                ctx.globalAlpha = 0.3 - i * 0.04;
            }
            ctx.globalAlpha = 1;
            const barWidth = 6;
            const barCount = Math.floor(canvas.width / (barWidth + 4));
            for (let i = 0; i < barCount; i++) {
                const height = Math.sin(time * 0.2 + i * 0.4) * 80 + 80;
                ctx.fillStyle = '#00f0ff';
                ctx.globalAlpha = 0.6;
                ctx.fillRect(i * (barWidth + 4), canvas.height * 0.85 - height, barWidth, height);
            }
            ctx.globalAlpha = 1;
            time += 0.08;
            requestAnimationFrame(drawWave);
        }
        drawWave();
    }

    // 导航栏滚动效果
    function handleNavbarScroll() {
        const navbar = document.getElementById('navbar');
        if (!navbar) return;
        window.addEventListener('scroll', () => {
            if (window.scrollY > 100) navbar.classList.add('nav-scrolled');
            else navbar.classList.remove('nav-scrolled');
