    // 通用工具函数
    function toggleMobileMenu() { document.getElementById('mobile-menu').classList.toggle('hidden'); }
    function showVideo() { const m = document.getElementById('video-modal'); m.classList.remove('hidden'); m.classList.add('flex'); }
    function hideVideo() { const m = document.getElementById('video-modal'); m.classList.add('hidden'); m.classList.remove('flex'); }
    function smoothScrollTo(section) { const el = document.getElementById(section); if (el) el.scrollIntoView({ behavior: 'smooth' }); }
    function handleSubmit(e) { e.preventDefault(); alert('✅ 询价需求已提交！我们将尽快回复。'); e.target.reset(); }

    // 初始化
    window.onload = function () {
        updateDynamicDates();
        initWaveCanvas();
        handleNavbarScroll();
        renderProductsSection();
        renderProjectsSection();
    };
</script>
