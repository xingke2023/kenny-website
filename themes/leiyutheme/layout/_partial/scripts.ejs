        { name: "户外演出音箱", brand: "EGT", desc: "IP65防水防尘，适合露天音乐节与体育场", footer: "全天候使用", imgId: "1005" },
        { name: "KTV包间音箱", brand: "MENESS", desc: "高保真还原，专业KTV连锁店标配", footer: "多声道配置", imgId: "237" },
